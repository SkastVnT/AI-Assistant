# ============= AI API KEYS =============
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GROK_API_KEY=                    # FREE API from https://x.ai

# ============= PERFORMANCE & DATABASE =============
# Redis cache (default: localhost)
REDIS_URL=redis://localhost:6379/0

# MongoDB (Atlas connection string)
# Get your MongoDB URI from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=YOUR_APP
MONGODB_DB_NAME=chatbot_db
MONGODB_TLS_ALLOW_INVALID_CERTIFICATES=false

# ============= STABLE DIFFUSION =============
SD_API_URL=http://127.0.0.1:8188
IMAGE_FIRST_MODE=1             # 1 = ưu tiên tạo ảnh khi image tool đang bật
AUTO_START_IMAGE_SERVICES=1    # 1 = khi chạy chatbot sẽ tự bật các service ảnh phụ trợ
AUTO_START_COMFYUI=1
AUTO_START_STABLE_DIFFUSION=1
IMAGE_SERVICE_VISIBLE_WINDOWS=1
COMFYUI_CPU_MODE=auto          # auto = tự thêm --cpu nếu torch không có CUDA
STABLE_DIFFUSION_PORT=7861
STABLE_DIFFUSION_START_COMMAND=  # Optional: custom Windows command if services/stable-diffusion has no webui.bat

# ============= IMAGE GENERATION V2 (Multi-Provider) =============
FAL_API_KEY=                    # fal.ai — https://fal.ai/dashboard/keys
REPLICATE_API_TOKEN=            # Replicate — https://replicate.com/account/api-tokens
BFL_API_KEY=                    # Black Forest Labs — https://api.bfl.ml
TOGETHER_API_KEY=               # Together.ai (FREE tier) — https://api.together.xyz
STEPFUN_API_KEY=                # StepFun — https://platform.stepfun.com
COMFYUI_URL=http://127.0.0.1:8189   # Local ComfyUI (FREE)
IMGBB_API_KEY=                  # ImgBB image hosting — https://api.imgbb.com
IMAGE_GEN_DEFAULT_MODEL=nano-banana-auto   # nano-banana-pro | nano-banana-2 | nano-banana-auto

# ============= RAG (Retrieval-Augmented Generation) =============
RAG_ENABLED=false                              # true to activate RAG pipeline
RAG_DATABASE_URL=sqlite+aiosqlite:///./rag.db  # async DB URL for metadata
RAG_EMBED_PROVIDER=openai                      # openai | gemini
RAG_EMBED_MODEL=text-embedding-3-small
RAG_EMBED_DIM=1536
RAG_TOP_K=5
RAG_MIN_SCORE=0.3
REDIS_URL=redis://localhost:6379/0             # cache / pub-sub
MINIO_ENDPOINT=localhost:9000                  # S3-compatible object store
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-files
RAG_CACHE_TTL=3600                             # seconds

# ============= LAST30DAYS — Social Research =============
LAST30DAYS_ENABLED=false
LAST30DAYS_SCRIPT_PATH=                        # auto-detected from vendor/
LAST30DAYS_PYTHON_PATH=python                  # Python 3.12+ path
LAST30DAYS_TIMEOUT=180                         # seconds

# ============= HERMES AGENT — Advanced AI Sidecar =============
HERMES_ENABLED=false
HERMES_API_URL=http://localhost:8080
HERMES_API_KEY=

# ============= CHARACTER SELECT SAA — Picker Sidecar =============
# Source: https://github.com/mirabarukaso/character_select_stand_alone_app
CHARACTER_SELECT_ENABLED=false
CHARACTER_SELECT_URL=http://localhost:51028
CHARACTER_SELECT_PORT=51028
CHARACTER_SELECT_AUTO_START=false                # 1 = spawn `npm start` on chatbot launch
CHARACTER_SELECT_PATH=./app/character_select_stand_alone_app-main
CHARACTER_SELECT_TIMEOUT=5
