{
    "name": "ai-assistant-desktop",
    "version": "0.1.0",
    "private": true,
    "description": "Electron desktop wrapper for AI-Assistant. Spawns Python backend + ComfyUI and loads http://127.0.0.1:5000.",
    "main": "src/main.js",
    "scripts": {
        "dev": "electron . --dev",
        "start": "electron .",
        "prepare-payload": "node scripts/prepare-payload.js",
        "prepare-payload-lite": "node scripts/prepare-payload-lite.js",
        "build:installer": "node scripts/prepare-payload.js && electron-builder --win --x64 --publish never",
        "build:installer-lite": "node scripts/prepare-payload-lite.js && electron-builder --win --x64 --config electron-builder-lite.yml --publish never",
        "build:dir": "node scripts/prepare-payload.js && electron-builder --win --dir --x64 --publish never",
        "build:dir-lite": "node scripts/prepare-payload-lite.js && electron-builder --win --dir --x64 --config electron-builder-lite.yml --publish never",
        "build:local": "electron-builder --win dir --x64 --config electron-builder-local.yml --publish never",
        "test:payload": "node tests/payload-filter.test.js",
        "test:preload": "node tests/preload-contract.test.js",
        "test": "node tests/payload-filter.test.js && node tests/preload-contract.test.js"
    },
    "license": "MIT",
    "dependencies": {
        "electron-updater": "^6.8.9"
    },
    "devDependencies": {
        "electron": "^42.5.1",
        "electron-builder": "^26.15.3",
        "fs-extra": "^11.2.0"
    }
}
